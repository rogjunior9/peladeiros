# ============================================
# CONFIGURAÇÃO OBRIGATÓRIA
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/peladeiros?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sua-chave-secreta-aqui-minimo-32-caracteres"

# Google OAuth
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# ============================================
# CONFIGURAÇÃO DE ADMINISTRADORES
# ============================================

# Lista de emails separados por vírgula que serão promovidos automaticamente a ADMIN
ADMIN_EMAILS="admin@exemplo.com,outro@exemplo.com"

# Email legacy (para compatibilidade - será removido em breve)
# LEGACY_ADMIN_EMAIL="email@antigo.com"

# Domínios de email permitidos (opcional - deixe vazio para permitir todos)
# ALLOWED_EMAIL_DOMAINS="gmail.com,empresa.com.br"

# ============================================
# PAGSEGURO (Pagamentos)
# ============================================

PAGSEGURO_EMAIL="seu-email-pagseguro"
PAGSEGURO_TOKEN="seu-token-pagseguro"
PAGSEGURO_SANDBOX="true"
PAGSEGURO_NOTIFICATION_URL="https://seu-dominio.com/api/webhooks/pagseguro"

# Chave secreta para validar webhooks (opcional mas recomendado)
# PAGSEGURO_WEBHOOK_SECRET="chave-secreta-para-validar-webhooks"

# IPs permitidos para webhooks do PagSeguro (opcional)
# PAGSEGURO_WEBHOOK_IPS="1.2.3.4,5.6.7.8"

# ============================================
# N8N (Automações)
# ============================================

N8N_WEBHOOK_URL="https://n8n.seu-dominio.com"
N8N_API_KEY="sua-api-key-do-n8n"
N8N_WORKFLOW_ID="id-do-workflow"

# ============================================
# SEGURANÇA
# ============================================

# Secret para proteger cron jobs (GERE UMA CHAVE FORTE!)
# Use: openssl rand -base64 32
CRON_SECRET="sua-chave-secreta-para-cron-jobs"

# Rate limiting (Redis - opcional, para produção)
# REDIS_URL="redis://localhost:6379"

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================

# Porta do servidor (padrão: 3000)
# PORT=3000

# Hostname (padrão: localhost)
# HOSTNAME="0.0.0.0"

# ============================================
# INSTRUÇÕES DE SEGURANÇA
# ============================================
# 
# 1. NUNCA commit este arquivo .env real no Git!
#    Use apenas .env.example (sem valores reais)
#
# 2. Gere NEXTAUTH_SECRET com:
#    openssl rand -base64 32
#
# 3. Gere CRON_SECRET com:
#    openssl rand -base64 32
#
# 4. Em produção:
#    - Use HTTPS sempre
#    - Configure CORS apropriadamente
#    - Ative rate limiting
#    - Configure firewall
#
# 5. PagSeguro:
#    - Em produção, mude PAGSEGURO_SANDBOX para "false"
#    - Configure PAGSEGURO_WEBHOOK_SECRET para validar webhooks
#
# 6. N8N:
#    - Proteja seus webhooks no N8N
#    - Use autenticação nas chamadas
#
